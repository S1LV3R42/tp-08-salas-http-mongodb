<h1><%= seccion %></h1><% if (error) { %><div class="alerta-error" role="alert"><p><%= error %></p></div><% } %><form action="/reservas" method="post"><div class="campo"><label>Estudiante:</label><input type="text" name="estudiante" value="<%= datosIngresados.estudiante || '' %>"></div><div class="campo"><label>Email:</label><input type="email" name="email" value="<%= datosIngresados.email || '' %>"></div><div class="campo"><label>Sala:</label><select name="sala"><% salasPermitidas.forEach(s => { %><option value="<%= s %>" <%= datosIngresados.sala === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div><div class="campo"><label>Fecha:</label><input type="date" name="fecha" value="<%= datosIngresados.fecha || '' %>"></div><div class="campo"><label>Turno:</label><select name="turno"><option value="Mañana" <%= datosIngresados.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option><option value="Tarde" <%= datosIngresados.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option><option value="Noche" <%= datosIngresados.turno === 'Noche' ? 'selected' : '' %>>Noche</option></select></div><div class="campo"><label>Personas:</label><input type="number" name="personas" value="<%= datosIngresados.personas || '' %>"></div><button class="boton" type="submit">Guardar Reserva Definitiva</button></form>